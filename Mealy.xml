<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<structure>
	<type>mealy</type>
	<automaton>
		<!-- Convenção: usar sempre estados nomeados q0, q1, q2, q3 em ordem -->
		<!-- Estados -->
		<state id="0" name="q0">
			<initial/>
		</state>
		<state id="1" name="q1">
		<!-- O rótulo (label) define o nome ou valor associado ao estado. -->
		<label>R$1,00</label>
		</state>
		<state id="2" name="q2">
			<label>R$0,50</label>
		</state>
		<!-- Transições -->
		<transition>
			<from>0</from>
			<to>1</to>
			<read>a</read>
			<transout/>
		</transition>
		<transition>
			<from>0</from>
			<to>2</to>
			<read>b</read>
			<transout/>
		</transition>
	</automaton>
</structure>