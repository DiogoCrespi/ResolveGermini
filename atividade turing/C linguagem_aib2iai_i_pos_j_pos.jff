<?xml version="1.0" encoding="UTF-8" standalone="no"?><!--Created with JFLAP 7.1.--><structure>
	<type>turing</type>
	<automaton>
		<!--The list of states.-->
		<state id="8" name="q_init">
			<x>50.0</x>
			<y>200.0</y>
			<initial/>
			<label>Garante i > 0</label>
		</state>
		<state id="0" name="q0">
			<x>150.0</x>
			<y>200.0</y>
			<label>Procura prox 'a' ou vai verificar</label>
		</state>
		<state id="1" name="q1">
			<x>300.0</x>
			<y>100.0</y>
			<label>Achou 'a', procura 1o 'b'</label>
		</state>
		<state id="2" name="q2">
			<x>450.0</x>
			<y>100.0</y>
			<label>Marcou 1o 'b', procura 2o 'b'</label>
		</state>
		<state id="3" name="q3">
			<x>600.0</x>
			<y>100.0</y>
			<label>Marcou 2o 'b', procura 'a' final</label>
		</state>
		<state id="4" name="q4">
			<x>450.0</x>
			<y>200.0</y>
			<label>Marcou 'a' final, volta para X</label>
		</state>
		<state id="5" name="q5">
			<x>300.0</x>
			<y>300.0</y>
			<label>Verifica Ys</label>
		</state>
		<state id="6" name="q6">
			<x>450.0</x>
			<y>300.0</y>
			<label>Verifica Zs</label>
		</state>
		<state id="7" name="q7">
			<x>600.0</x>
			<y>300.0</y>
			<label>Aceita</label>
			<final/>
		</state>
		<!--The list of transitions.-->
		
		<!-- Estado Inicial -->
		<transition> <!-- Garante i>0 e marca 1o 'a' -->
			<from>8</from>
			<to>1</to>
			<read>a</read>
			<write>X</write>
			<move>R</move>
		</transition>
        <!-- Se q_init ler b, Z, Y, ou branco -> Rejeita (sem transição) -->
        
		<!-- Ciclo Principal -->
		<transition> <!-- Procura prox 'a' nao marcado -->
			<from>0</from>
			<to>0</to>
			<read>X</read>
			<write>X</write>
			<move>R</move>
		</transition>
		<transition> <!-- Encontrou 'a', marca e inicia ciclo -->
			<from>0</from>
			<to>1</to>
			<read>a</read>
			<write>X</write>
			<move>R</move>
		</transition>
		<transition> <!-- Pula 'a's -->
			<from>1</from>
			<to>1</to>
			<read>a</read>
			<write>a</write>
			<move>R</move>
		</transition>
		<transition> <!-- Pula 'Y's (b marcados) -->
			<from>1</from>
			<to>1</to>
			<read>Y</read>
			<write>Y</write>
			<move>R</move>
		</transition>
		<transition> <!-- Marca 1o 'b' -> Y -->
			<from>1</from>
			<to>2</to>
			<read>b</read>
			<write>Y</write>
			<move>R</move>
		</transition>
		<transition> <!-- Pula 'Y's -->
			<from>2</from>
			<to>2</to>
			<read>Y</read>
			<write>Y</write>
			<move>R</move>
		</transition>
		<transition> <!-- Marca 2o 'b' -> Y -->
			<from>2</from>
			<to>3</to>
			<read>b</read>
			<write>Y</write>
			<move>R</move>
		</transition>
		<transition> <!-- Pula 'b's -->
			<from>3</from>
			<to>3</to>
			<read>b</read>
			<write>b</write>
			<move>R</move>
		</transition>
		<transition> <!-- Pula 'Y's -->
			<from>3</from>
			<to>3</to>
			<read>Y</read>
			<write>Y</write>
			<move>R</move>
		</transition>
		<transition> <!-- Pula 'Z's (a final marcado) -->
			<from>3</from>
			<to>3</to>
			<read>Z</read>
			<write>Z</write>
			<move>R</move>
		</transition>
		<transition> <!-- Marca 'a' final -> Z -->
			<from>3</from>
			<to>4</to>
			<read>a</read>
			<write>Z</write>
			<move>L</move>
		</transition>
		<transition> <!-- Volta L sobre Z -->
			<from>4</from>
			<to>4</to>
			<read>Z</read>
			<write>Z</write>
			<move>L</move>
		</transition>
		<transition> <!-- Volta L sobre Y -->
			<from>4</from>
			<to>4</to>
			<read>Y</read>
			<write>Y</write>
			<move>L</move>
		</transition>
		<transition> <!-- Volta L sobre b -->
			<from>4</from>
			<to>4</to>
			<read>b</read>
			<write>b</write>
			<move>L</move>
		</transition>
		<transition> <!-- Volta L sobre a -->
			<from>4</from>
			<to>4</to>
			<read>a</read>
			<write>a</write>
			<move>L</move>
		</transition>
		<transition> <!-- Encontrou X, move R para reiniciar ciclo -->
			<from>4</from>
			<to>0</to>
			<read>X</read>
			<write>X</write>
			<move>R</move>
		</transition>

		<!-- Transição para Verificação Final -->
		<transition> <!-- q0 nao achou 'a', achou 'Y' -> Fim dos a's iniciais -->
			<from>0</from>
			<to>5</to>
			<read>Y</read>
			<write>Y</write>
			<move>R</move>
		</transition>

		<!-- Verificação Final -->
		<transition> <!-- Pula Ys -->
			<from>5</from>
			<to>5</to>
			<read>Y</read>
			<write>Y</write>
			<move>R</move>
		</transition>
		<transition> <!-- Acabou Ys, comeca a verificar Zs -->
			<from>5</from>
			<to>6</to>
			<read>Z</read>
			<write>Z</write>
			<move>R</move>
		</transition>
        <!-- Se q5 encontrar a, b ou _ -> Rejeita (sem transicao) -->
        
		<transition> <!-- Pula Zs e vai para verificação final -->
			<from>6</from>
			<to>6</to>
			<read>Z</read>
			<write>Z</write>
			<move>R</move>
		</transition>
		<transition> <!-- Todos Zs verificados, branco -> Aceita -->
			<from>6</from>
			<to>7</to>
			<read/>
			<write/>
			<move>S</move>
		</transition>
        <!-- Se q6 encontrar a, b, Y -> Rejeita (sem transicao) -->

	</automaton>
</structure>
