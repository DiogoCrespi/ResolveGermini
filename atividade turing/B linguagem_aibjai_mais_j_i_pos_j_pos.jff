<?xml version="1.0" encoding="UTF-8" standalone="no"?><!--Created with JFLAP 7.1.--><structure>
	<type>turing</type>
	<automaton>
		<!--The list of states.-->
		<state id="11" name="q_start">
			<x>50.0</x>
			<y>200.0</y>
			<initial/>
			<label>Garante i > 0</label>
		</state>
		<state id="0" name="q0">
			<x>100.0</x>
			<y>200.0</y>
			<label>Procura 'a' inicial</label>
		</state>
		<state id="1" name="q1">
			<x>250.0</x>
			<y>100.0</y>
			<label>Vai para fim da fita</label>
		</state>
		<state id="2" name="q2">
			<x>400.0</x>
			<y>100.0</y>
			<label>Marca 'a' final (Z)</label>
		</state>
		<state id="3" name="q3">
			<x>550.0</x>
			<y>100.0</y>
			<label>Volta para X</label>
		</state>
		<state id="4" name="q4">
			<x>100.0</x>
			<y>350.0</y>
			<label>Procura 'b'</label>
		</state>
		<state id="5" name="q5">
			<x>250.0</x>
			<y>450.0</y>
			<label>Vai para fim da fita</label>
		</state>
		<state id="6" name="q6">
			<x>400.0</x>
			<y>450.0</y>
			<label>Marca 'a' ou 'Z' final (W)</label>
		</state>
		<state id="7" name="q7">
			<x>550.0</x>
			<y>450.0</y>
			<label>Volta para Y</label>
		</state>
		<state id="8" name="q_verify">
			<x>250.0</x>
			<y>275.0</y>
			<label>Verificacao Final</label>
		</state>
		<state id="9" name="q_accept">
			<x>400.0</x>
			<y>275.0</y>
			<label>Aceita</label>
			<final/>
		</state>
		<!--The list of transitions.-->

		<!-- Estado Inicial: Garante i > 0 -->
		<transition> <!-- Marca primeiro 'a' -> X (obrigatório) -->
			<from>11</from>
			<to>1</to>
			<read>a</read>
			<write>X</write>
			<move>R</move>
		</transition>
		<!-- Se q_start encontrar 'b', branco ou outro símbolo -> REJEITA (sem transição) -->

		<!-- Fase 1: Marcar 'a' inicial (i) e 'a' final correspondente -->
		<transition> <!-- Marca 'a' -> X -->
			<from>0</from>
			<to>1</to>
			<read>a</read>
			<write>X</write>
			<move>R</move>
		</transition>
		<transition> <!-- Pula 'a' -->
			<from>1</from>
			<to>1</to>
			<read>a</read>
			<write>a</write>
			<move>R</move>
		</transition>
		<transition> <!-- Pula 'b' -->
			<from>1</from>
			<to>1</to>
			<read>b</read>
			<write>b</write>
			<move>R</move>
		</transition>
        <transition> <!-- Pula 'Y' (b marcado) -->
            <from>1</from>
            <to>1</to>
            <read>Y</read>
            <write>Y</write>
            <move>R</move>
        </transition>
		<transition> <!-- Pula 'Z' (a final p/ i marcado) -->
			<from>1</from>
			<to>1</to>
			<read>Z</read>
			<write>Z</write>
			<move>R</move>
		</transition>
        <transition> <!-- Pula 'W' (a final p/ j marcado) -->
             <from>1</from>
             <to>1</to>
             <read>W</read>
             <write>W</write>
             <move>R</move>
         </transition>
		<transition> <!-- Chegou ao fim, volta L -->
			<from>1</from>
			<to>2</to>
			<read/>
			<write/>
			<move>L</move>
		</transition>
		<transition> <!-- Pula 'Z' para encontrar 'a' -->
			<from>2</from>
			<to>2</to>
			<read>Z</read>
			<write>Z</write>
			<move>L</move>
		</transition>
        <transition> <!-- Pula 'W' para encontrar 'a' -->
            <from>2</from>
            <to>2</to>
            <read>W</read>
            <write>W</write>
            <move>L</move>
        </transition>
		<transition> <!-- Marca último 'a' -> Z -->
			<from>2</from>
			<to>3</to>
			<read>a</read>
			<write>Z</write>
			<move>L</move>
		</transition>
		<transition> <!-- Se encontrar b ou Y, rejeita (ordem errada ou i>i+j) -->
			<from>2</from>
			<to>2</to> <!-- Fica num loop implicito de rejeicao ou vai para estado reject -->
			<read>b</read>
			<write>b</write>
			<move>S</move>
		</transition>
        <transition>
            <from>2</from>
            <to>2</to>
            <read>Y</read>
            <write>Y</write>
            <move>S</move>
        </transition>
		<transition> <!-- Volta L sobre a, b, Y, Z, W -->
			<from>3</from>
			<to>3</to>
			<read>a</read>
			<write>a</write>
			<move>L</move>
		</transition>
		<transition>
			<from>3</from>
			<to>3</to>
			<read>b</read>
			<write>b</write>
			<move>L</move>
		</transition>
		<transition>
			<from>3</from>
			<to>3</to>
			<read>Y</read>
			<write>Y</write>
			<move>L</move>
		</transition>
		<transition>
			<from>3</from>
			<to>3</to>
			<read>Z</read>
			<write>Z</write>
			<move>L</move>
		</transition>
        <transition>
             <from>3</from>
             <to>3</to>
             <read>W</read>
             <write>W</write>
             <move>L</move>
         </transition>
		<transition> <!-- Encontrou X, volta R para q0 -->
			<from>3</from>
			<to>0</to>
			<read>X</read>
			<write>X</write>
			<move>R</move>
		</transition>
		<transition> <!-- Fim dos 'a' iniciais: q0 encontra 'b' ou 'Y' -->
			<from>0</from>
			<to>4</to> <!-- Inicia Fase B -->
			<read>b</read>
			<write>b</write> <!-- Não marca ainda, só transita -->
			<move>S</move> <!-- Fica no 'b' para marcar -->
		</transition>
        <transition> <!-- Transição caso n=0 (não permitido por i>0) mas para robustez, se encontrar Y -->
             <from>0</from>
             <to>4</to>
             <read>Y</read>
             <write>Y</write>
             <move>S</move>
         </transition>
         <transition> <!-- Transição se q2 não encontra 'a', mas encontra 'X' (fim dos 'a' iniciais) -->
             <from>2</from>
             <to>4</to> <!-- Vai para fase B -->
             <read>X</read>
             <write>X</write>
             <move>R</move> <!-- Move R para encontrar o primeiro b/Y -->
         </transition>

		<!-- Fase 2: Marcar 'b' (j) e 'a' ou 'Z' final correspondente (W) -->
		<transition> <!-- Pula 'Y' (b marcado) -->
			<from>4</from>
			<to>4</to>
			<read>Y</read>
			<write>Y</write>
			<move>R</move>
		</transition>
		<transition> <!-- Marca 'b' -> Y -->
			<from>4</from>
			<to>5</to>
			<read>b</read>
			<write>Y</write>
			<move>R</move>
		</transition>
		<!-- Se q4 encontrar 'a' ou 'Z' -> REJEITA (a's ou Z's não deveriam estar entre b's não marcados) -->
		<transition> <!-- Pula 'a' (não marcado) -->
			<from>5</from>
			<to>5</to>
			<read>a</read>
			<write>a</write>
			<move>R</move>
		</transition>
		<transition> <!-- Pula 'b' -->
			<from>5</from>
			<to>5</to>
			<read>b</read>
			<write>b</write>
			<move>R</move>
		</transition>
        <transition> <!-- Pula 'Y' -->
            <from>5</from>
            <to>5</to>
            <read>Y</read>
            <write>Y</write>
            <move>R</move>
        </transition>
		<transition> <!-- Pula 'Z' -->
			<from>5</from>
			<to>5</to>
			<read>Z</read>
			<write>Z</write>
			<move>R</move>
		</transition>
        <transition> <!-- Pula 'W' -->
            <from>5</from>
            <to>5</to>
            <read>W</read>
            <write>W</write>
            <move>R</move>
        </transition>
		<transition> <!-- Chegou ao fim, volta L -->
			<from>5</from>
			<to>6</to>
			<read/>
			<write/>
			<move>L</move>
		</transition>
		<transition> <!-- Pula 'W' para encontrar 'a' -->
			<from>6</from>
			<to>6</to>
			<read>W</read>
			<write>W</write>
			<move>L</move>
		</transition>
		<transition> <!-- Pula 'Z' para encontrar 'a' não marcado -->
			<from>6</from>
			<to>6</to>
			<read>Z</read>
			<write>Z</write>
			<move>L</move>
		</transition>
        <transition> <!-- Marca último 'a' não marcado -> W -->
            <from>6</from>
            <to>7</to>
            <read>a</read>
            <write>W</write>
            <move>L</move>
        </transition>
        <!-- Se q6 não encontrar 'a', significa que j > número de a's não marcados -> REJEITA -->
        <transition> <!-- Se encontrar Y ou b, rejeita (ordem errada ou j>i+j) -->
            <from>6</from>
            <to>6</to>
            <read>Y</read>
            <write>Y</write>
            <move>S</move>
        </transition>
        <transition>
            <from>6</from>
            <to>6</to>
            <read>b</read>
            <write>b</write>
            <move>S</move>
        </transition>
		<transition> <!-- Volta L sobre a, b, Y, Z, W -->
			<from>7</from>
			<to>7</to>
			<read>a</read>
			<write>a</write>
			<move>L</move>
		</transition>
		<transition>
			<from>7</from>
			<to>7</to>
			<read>b</read>
			<write>b</write>
			<move>L</move>
		</transition>
		<transition>
			<from>7</from>
			<to>7</to>
			<read>Z</read>
			<write>Z</write>
			<move>L</move>
		</transition>
		<transition>
			<from>7</from>
			<to>7</to>
			<read>W</read>
			<write>W</write>
			<move>L</move>
		</transition>
		<transition> <!-- Encontrou Y, volta R para q4 -->
			<from>7</from>
			<to>4</to>
			<read>Y</read>
			<write>Y</write>
			<move>R</move>
		</transition>
		<transition> <!-- Se chegar até X, volta R para q4 -->
			<from>7</from>
			<to>4</to>
			<read>X</read>
			<write>X</write>
			<move>R</move>
		</transition>
		<transition> <!-- Fim dos 'b's: q4 encontra 'W' (não deveria encontrar 'Z') -->
			<from>4</from>
			<to>8</to> <!-- Inicia Verificação Final -->
			<read>W</read>
			<write>W</write>
			<move>R</move>
		</transition>

		<!-- Fase 3: Verificação Final -->
		<transition> <!-- Pula 'W' até o final -->
			<from>8</from>
			<to>8</to>
			<read>W</read>
			<write>W</write>
			<move>R</move>
		</transition>
		<transition> <!-- Pula 'Z' até o final -->
			<from>8</from>
			<to>8</to>
			<read>Z</read>
			<write>Z</write>
			<move>R</move>
		</transition>
		<transition> <!-- Chegou ao branco -> Aceita (todos os símbolos foram marcados corretamente) -->
			<from>8</from>
			<to>9</to>
			<read/>
			<write/>
			<move>S</move>
		</transition>
		<!-- Se q8 encontrar 'a' ou 'b' não marcado -> REJEITA (sem transição definida, máquina para) -->

	</automaton>
</structure>

