			<label>Aceita</label>
		</state>
		<state id="10" name="q_reject">
			<x>600.0</x>
			<y>100.0</y>
			<label>Rejeita</label>
		</state>
		<!--The list of transitions.-->
		<!-- q_init: marca primeiro 'a' com X -->
		<transition>
			<from>0</from>
			<to>1</to>
			<read>a</read>
			<write>X</write>
			<move>R</move>
		</transition>
