<?xml version="1.0" encoding="UTF-8" standalone="no"?><!--Created with JFLAP 7.1.--><structure>
	<type>turing</type>
	<tapes>1</tapes>
	<automaton>
		<!--The list of states.-->
		<state id="0" name="q_init">
