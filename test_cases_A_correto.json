{
  "language": "{ a^n b^m c^(2n) d^m | n > 0 e m > 0 }",
  "test_cases": [
    {
      "input": "abccd",
      "expected": true,
      "reason": "caso mínimo válido - n=1, m=1"
    },
    {
      "input": "abbccdd",
      "expected": true,
      "reason": "n=1, m=2 - n=1, m=2"
    },
    {
      "input": "aabccccd",
      "expected": true,
      "reason": "n=2, m=1 - n=2, m=1"
    },
    {
      "input": "aabbccccdd",
      "expected": true,
      "reason": "n=2, m=2 - n=2, m=2"
    },
    {
      "input": "aaabccccccd",
      "expected": true,
      "reason": "n=3, m=1 - n=3, m=1"
    },
    {
      "input": "aaabbccccccdd",
      "expected": true,
      "reason": "n=3, m=2 - n=3, m=2"
    },
    {
      "input": "aaaabbbccccccccddd",
      "expected": true,
      "reason": "n=4, m=3 - n=4, m=3"
    },
    {
      "input": "aaaaabbbbbccccccccccddddd",
      "expected": true,
      "reason": "caso maior - n=5, m=5"
    },
    {
      "input": "abcd",
      "expected": false,
      "reason": "Falta um c (precisa de 2 c's para n=1)"
    },
    {
      "input": "aabbccdd",
      "expected": false,
      "reason": "n=2 mas só tem 2 c's (deveria ter 4)"
    },
    {
      "input": "abccdd",
      "expected": false,
      "reason": "m=2 (2 d's) mas só tem 1 b"
    },
    {
      "input": "abbbccd",
      "expected": false,
      "reason": "m=3 (3 b's) mas só tem 1 d"
    },
    {
      "input": "aabcccccd",
      "expected": false,
      "reason": "n=2 mas tem c a mais (5 c's, deveria ter 4)"
    },
    {
      "input": "bccd",
      "expected": false,
      "reason": "Falta a (n deve ser > 0)"
    },
    {
      "input": "accd",
      "expected": false,
      "reason": "Falta b (m deve ser > 0)"
    },
    {
      "input": "abcc",
      "expected": false,
      "reason": "Falta d (m deve ser > 0)"
    },
    {
      "input": "abbdccdd",
      "expected": false,
      "reason": "Ordem incorreta (d antes de c)"
    },
    {
      "input": "aabbccccbdd",
      "expected": false,
      "reason": "Ordem incorreta (b no meio dos c's)"
    },
    {
      "input": "",
      "expected": false,
      "reason": "String vazia"
    },
    {
      "input": "aaabcccccc",
      "expected": false,
      "reason": "m=0 (sem b's)"
    }
  ]
}