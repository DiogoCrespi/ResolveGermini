<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<structure>
    <type>turing</type>
    <automaton>
        <!-- Estados -->
        <state id="0" name="q0">
            <x>200.0</x>
            <y>200.0</y>
            <initial/>
        </state>
        <state id="1" name="q1">
            <x>400.0</x>
            <y>200.0</y>
        </state>
        <state id="2" name="q2">
            <x>600.0</x>
            <y>200.0</y>
        </state>
        <state id="3" name="q3">
            <x>800.0</x>
            <y>200.0</y>
        </state>
        <state id="4" name="q4">
            <x>1000.0</x>
            <y>200.0</y>
        </state>
        <state id="5" name="q5">
            <x>1200.0</x>
            <y>200.0</y>
            <final/>
        </state>
        <state id="6" name="q6">
            <x>800.0</x>
            <y>400.0</y>
        </state>
        
        <!-- Transições -->
        <!-- q0: percorre a fita procurando por 'b' -->
        <transition>
            <from>0</from>
            <to>0</to>
            <read>a</read>
            <write>a</write>
            <move>R</move>
        </transition>
        <transition>
            <from>0</from>
            <to>1</to>
            <read>b</read>
            <write>X</write>
            <move>L</move>
        </transition>
        <transition>
            <from>0</from>
            <to>5</to>
            <read></read>
            <write></write>
            <move>S</move>
        </transition>
        
        <!-- q1: volta procurando o primeiro 'a' para marcar -->
        <transition>
            <from>1</from>
            <to>1</to>
            <read>a</read>
            <write>a</write>
            <move>L</move>
        </transition>
        <transition>
            <from>1</from>
            <to>1</to>
            <read>b</read>
            <write>b</write>
            <move>L</move>
        </transition>
        <transition>
            <from>1</from>
            <to>1</to>
            <read>X</read>
            <write>X</write>
            <move>L</move>
        </transition>
        <transition>
            <from>1</from>
            <to>2</to>
            <read></read>
            <write></write>
            <move>R</move>
        </transition>
        
        <!-- q2: procura o primeiro 'a' para marcar -->
        <transition>
            <from>2</from>
            <to>2</to>
            <read>a</read>
            <write>a</write>
            <move>R</move>
        </transition>
        <transition>
            <from>2</from>
            <to>3</to>
            <read>a</read>
            <write>Y</write>
            <move>R</move>
        </transition>
        <transition>
            <from>2</from>
            <to>6</to>
            <read>b</read>
            <write>b</write>
            <move>S</move>
        </transition>
        <transition>
            <from>2</from>
            <to>6</to>
            <read>X</read>
            <write>X</write>
            <move>S</move>
        </transition>
        <transition>
            <from>2</from>
            <to>6</to>
            <read></read>
            <write></write>
            <move>S</move>
        </transition>
        
        <!-- q3: procura o segundo 'a' para marcar -->
        <transition>
            <from>3</from>
            <to>3</to>
            <read>a</read>
            <write>a</write>
            <move>R</move>
        </transition>
        <transition>
            <from>3</from>
            <to>3</to>
            <read>b</read>
            <write>b</write>
            <move>R</move>
        </transition>
        <transition>
            <from>3</from>
            <to>3</to>
            <read>X</read>
            <write>X</write>
            <move>R</move>
        </transition>
        <transition>
            <from>3</from>
            <to>4</to>
            <read>a</read>
            <write>Z</write>
            <move>L</move>
        </transition>
        <transition>
            <from>3</from>
            <to>6</to>
            <read></read>
            <write></write>
            <move>S</move>
        </transition>
        
        <!-- q4: volta para o início -->
        <transition>
            <from>4</from>
            <to>4</to>
            <read>a</read>
            <write>a</write>
            <move>L</move>
        </transition>
        <transition>
            <from>4</from>
            <to>4</to>
            <read>b</read>
            <write>b</write>
            <move>L</move>
        </transition>
        <transition>
            <from>4</from>
            <to>4</to>
            <read>X</read>
            <write>X</write>
            <move>L</move>
        </transition>
        <transition>
            <from>4</from>
            <to>4</to>
            <read>Y</read>
            <write>Y</write>
            <move>L</move>
        </transition>
        <transition>
            <from>4</from>
            <to>4</to>
            <read>Z</read>
            <write>Z</write>
            <move>L</move>
        </transition>
        <transition>
            <from>4</from>
            <to>0</to>
            <read></read>
            <write></write>
            <move>R</move>
        </transition>
        
        <!-- q6: estado de rejeição -->
        <transition>
            <from>6</from>
            <to>6</to>
            <read>a</read>
            <write>a</write>
            <move>S</move>
        </transition>
    </automaton>
</structure>
